<Window x:Class="Blocktavius.AppDQB2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Blocktavius.AppDQB2"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Slider x:Name="sliderZoom" Grid.Row="1" Orientation="Vertical" Minimum="0.5" Maximum="3.0" Value="1"></Slider>
        </Grid>
        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical">
                    <StackPanel.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ElementName=sliderZoom, Path=Value}" ScaleY="{Binding ElementName=sliderZoom, Path=Value}"></ScaleTransform>
                    </StackPanel.LayoutTransform>
                    <local:TileGridPainterControl DataContext="{Binding SelectedLayer.TileGridPainterVM}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ListView Grid.Column="0" x:Name="lvLayers" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="GotFocus" Handler="ListViewItem_GotFocus" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBox Text="{Binding LayerName}"></TextBox>
                        <StackPanel Orientation="Horizontal">
                            <Label>Scale:</Label>
                            <ComboBox SelectedItem="{Binding TileSize}" Width="50">
                                <sys:Int32>4</sys:Int32>
                                <sys:Int32>8</sys:Int32>
                                <sys:Int32>12</sys:Int32>
                                <sys:Int32>16</sys:Int32>
                                <sys:Int32>24</sys:Int32>
                                <sys:Int32>32</sys:Int32>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
